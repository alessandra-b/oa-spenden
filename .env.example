# Variabili d'ambiente da impostare su Vercel (Settings -> Environment Variables).
# Le chiavi LIVE vanno SOLO nell'ambiente "Production"; Preview/Development usano quelle di test.
# Dopo ogni modifica alle variabili serve un nuovo deploy (Deployments -> ... -> Redeploy).

# --- Saferpay -----------------------------------------------------------
SAFERPAY_CUSTOMER_ID=
SAFERPAY_TERMINAL_ID=          # terminale eCommerce (non "Secure PayGate")
SAFERPAY_API_USERNAME=
SAFERPAY_API_PASSWORD=
SAFERPAY_ENV=test              # "test" oppure "live"

# --- Sito ----------------------------------------------------------------
# Origini da cui i form possono chiamare l'API. Piu' origini separate da virgola,
# SENZA slash finale, con o senza "www" esattamente come nel browser.
ALLOWED_ORIGIN=https://www.orchestra-aurea.ch,https://orchestra-aurea.ch,https://neu.orchestra-aurea.ch
# Pagina "Danke" (donazioni). {lang} diventa de / en / it.
RETURN_PAGE_URL=https://www.orchestra-aurea.ch/{lang}/danke
# Pagina "Willkommen" (nuovi soci). Facoltativa: se manca si usa RETURN_PAGE_URL con /willkommen al posto di /danke.
MEMBER_RETURN_PAGE_URL=
# Indirizzo del sito per i link nelle email. Facoltativo: se manca si usa l'origine di RETURN_PAGE_URL.
SITE_URL=

# --- Soci -------------------------------------------------------------------
MEMBERSHIP_FEE_CHF=100         # quota annuale (anno solare)
# PDF degli statuti: link nel form e allegato all'email di conferma.
# Se manca, il form non mostra il link e l'email parte senza allegato.
STATUTEN_URL=
STATUTEN_URL_EN=               # facoltativo, solo se esiste una traduzione
STATUTEN_URL_IT=               # facoltativo, solo se esiste una traduzione

# --- Limiti ---------------------------------------------------------------
MAX_DONATION_CHF=100000        # tetto tecnico per donazione singola (da confermare con Saferpay/Fausto)

# --- Email (Brevo) ----------------------------------------------------------
# Chiave API: Brevo -> nome account in alto a destra -> SMTP & API -> API keys.
# In Brevo -> Security -> Authorised IPs la restrizione per IP deve essere DISATTIVATA
# (Vercel non ha un indirizzo IP fisso).
BREVO_API_KEY=
MAIL_FROM=info@orchestra-aurea.ch               # mittente conferme soci e donazioni
MAIL_FROM_NAME=Orchestra Aurea
MAIL_FROM_NEWSLETTER=newsletter@orchestra-aurea.ch  # mittente email di conferma newsletter
MAIL_TO_ADMIN=info@orchestra-aurea.ch           # chi riceve l'avviso di ogni nuovo socio / donazione
# Lista Brevo dei contatti newsletter. Facoltativa: se manca, la lista
# "Newsletter Orchestra Aurea" viene cercata (o creata) automaticamente.
BREVO_NEWSLETTER_LIST_ID=

# --- Redis (Upstash, da Vercel -> Storage -> Marketplace -> Upstash for Redis) ---
# Collegando il database al progetto Vercel queste variabili vengono create da sole.
# Servono per la notifica di Saferpay (email inviate anche se il browser non torna sul sito)
# e per non mandare mai due volte la stessa email. Senza Redis tutto funziona lo stesso,
# ma le email partono solo quando il browser torna dalla pagina di pagamento.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (in alternativa, con un database Upstash creato fuori da Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Sicurezza -----------------------------------------------------------
# Chiave per firmare i link e cifrare i dati dell'ordine. Facoltativa ma consigliata:
# una stringa casuale lunga (es. 64 caratteri). Se manca viene ricavata da SAFERPAY_API_PASSWORD.
# ATTENZIONE: se la cambi, i link di conferma newsletter gia' inviati smettono di funzionare.
OA_SECRET=

# --- Nota sulle anteprime -------------------------------------------------------
# Per provare su un deploy di anteprima (Preview) imposta solo per "Preview":
#   RETURN_PAGE_URL=https://<indirizzo-anteprima>/test-danke.html?lang={lang}
#   SITE_URL=https://neu.orchestra-aurea.ch
